# Airflow
AIRFLOW_UID=50000
_AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3
TZ=Europe/Moscow
_AIRFLOW_DB_UPGRADE=true
_AIRFLOW_WWW_USER_CREATE=true
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# _PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-apache-hdfs==3.4.0 apache-airflow-providers-celery==3.1.0
_ENV_FILE_PATH=.env

# Postgres for AirFlow
_POSTGRES_USER_AIRFLOW=airflow
_POSTGRES_PASSWORD_AIRFLOW=airflow
_POSTGRES_DB_AIRFLOW=airflow

# Hadoop
_CORE_CONF_fs_defaultFS=hdfs://172.21.0.30:8020
_HADOOP_CLUSTER_NAME=test_hadoop_sandbox  

# NiFi
_NIFI_WEB_HTTP_PORT=8000
_NIFI_WEB_HTTP_HOST=0.0.0.0
_NIFI_WEB_HTTPS_PORT=8443
_NIFI_WEB_HTTPS_HOST=0.0.0.0
_NIFI_SENSITIVE_PROPS_KEY=SuperSecretKey12345678901234567890
_NIFI_SECURITY_USER_AUTHORIZER=file-authorizer
_NIFI_SECURITY_USER_LOGIN_IDENTITY_PROVIDER=single-user-provider

# Zookeeper
_ALLOW_ANONYMOUS_LOGIN=yes
_ZOOKEEPER_CLIENT_PORT=2181
_TZ=Europe/Moscow

# Postgres for MLFlow
_POSTGRES_USER_MLFLOW=user
_POSTGRES_PASSWORD_MLFLOW=password
_POSTGRES_DB_MLFLOW=mlflowdb

# MLFlow
_MLFLOW_S3_ENDPOINT_URL=http://minio:9000
_AWS_ACCESS_KEY_ID=minio_user
_AWS_SECRET_ACCESS_KEY=minio_password
_MLFLOW_BACKEND_STORE_URI=postgresql://${_POSTGRES_USER_MLFLOW}:${_POSTGRES_PASSWORD_MLFLOW}@postgres_ml_flow:5432/${_POSTGRES_DB_MLFLOW}



# Minio
_MINIO_ROOT_USER=minio_user
_MINIO_ROOT_PASSWORD=minio_password


# Superset
_SUPERSET_SECRET_KEY=your-super-secret-key-change-in-prod
_SUPERSET_DB_URI=postgresql+psycopg2://superset:superset@postgres_superset:5432/superset
_SUPERSET_CONFIG_PATH=/app/pythonpath/superset_config.py

# Postgres for Superset
_POSTGRES_USER_SUPERSET=superset
_POSTGRES_PASSWORD_SUPERSET=superset
_POSTGRES_DB_SUPERSET=superset

# Trino
_JAVA_TOOL_OPTIONS=-Xmx4G



